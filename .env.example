# Uni Simu settings. Copy this file to .env and fill in what you need.
# .env is git-ignored: never commit it (it holds your API key and admin token).
# Real environment variables (e.g. Railway's "Variables") override this file.
# Everything except GEMINI_API_KEY is optional.

# --- Gemini --------------------------------------------------------------------------------
# Your key from https://aistudio.google.com/apikey (required for generation and voices).
GEMINI_API_KEY=

# Let users pick smarter (pricier) models in the panel. Off by default.
# ALLOW_MODEL_SELECTION=true
# Override the default level's models / voices.
# GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# GEMINI_TTS_VOICE=Charon
# GEMINI_TTS_VOICE_FEMALE=Kore
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Default thinking effort for lesson writing (low | medium | high); "low" is much cheaper.
# WHITEBOARD_THINKING=medium

# --- Server --------------------------------------------------------------------------------
# PORT=5173
# Behind a reverse proxy (Railway, nginx, Cloudflare...): read the visitor IP from X-Forwarded-For.
# TRUST_PROXY=true

# --- Admin panel (admin.html): usage per IP and bans ------------------------------
# Off unless set; 16 characters minimum. Use a long random string.
# ADMIN_TOKEN=
# Days of usage log kept (then deleted automatically).
# USAGE_RETENTION_DAYS=30

# --- Support link (top right) ----------------------------------------------------------------
# Defaults to the project's Patreon page; set your own (https only) to override it.
# SUPPORT_URL=https://example.com/support

# --- Data files (defaults under data/, which must persist: a Railway Volume) ------------------
# COURSEWORK_FILE=data/coursework.json
# CURSUS_FILE=data/cursus.json
# USAGE_FILE=data/usage.json
# BANS_FILE=data/bans.json
# RATINGS_FILE=data/ratings.json
# VOICE_CACHE_DIR=data/voice-cache
